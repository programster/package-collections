{
    "name": "programster/collections",
    "type": "library",
    "description": "Strictly typed collections, including readonly ones, with the same interface as ramsey/collection wherever possible.",
    "keywords": ["collection","library"],
    "homepage": "https://github.com/programster/package-collections",
    "license": "MIT",
    "authors": [
        {
            "name": "Stuart Page",
            "email": "sdpagent@gmail.com",
            "homepage": "https://blog.programster.org",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev" : {
        "phpstan/phpstan": "^2.3"
    },
    "suggest": {
    },
    "autoload": {
        "psr-4": {
            "Programster\\Collections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Programster\\Collections\\Testing\\": "testing/"
        }
    }
}
