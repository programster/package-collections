{
    "name": "programster/collections",
    "type": "library",
    "description": "Strictly typed collections, including readonly ones for defensive programming.",
    "keywords": ["collection","library"],
    "homepage": "https://github.com/programster/package-collections",
    "license": "MIT",
    "authors": [
        {
            "name": "Stuart Page",
            "email": "sdpagent@gmail.com",
            "homepage": "https://blog.programster.org",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev" : {
        "phpstan/phpstan": "^2.3"
    },
    "suggest": {
        "phpstan/extension-installer": "Loads this package's PHPStan rule (extension.neon), which reports maps created with elements that won't have string keys."
    },
    "autoload": {
        "psr-4": {
            "Programster\\Collections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Programster\\Collections\\Testing\\": "testing/"
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
