# Runs just the package's rule (extension.neon) over MapKeysExamples.php, for testing/tests/PhpStanRuleTest.php. Level 0
# keeps PHPStan's own checks out of the way, as the rule runs at every level.
includes:
    - ../../extension.neon

parameters:
    level: 0
    paths:
        - MapKeysExamples.php
